{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "model": "anthropic/claude-sonnet-5",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local MLX)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "omlx",
      },
      "models": {
        "Qwen3.5-27B-4bit": {
          "name": "Qwen3.5-27B-4bit",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768,
          },
        },
      },
    },
  },
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true,
      "headers": {
        "X-Moz-1st-Party-Data-Opt-Out": "1",
      },
    },
    "knowledge-mcp.global.api.aws/aws-knowledge-mcp": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true,
    },
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
    },
  },
  "plugin": ["opencode-export-html", "openslimedit@latest", "opencode-smartsnip@latest"],
}
