{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "model": "Ornith-1.5-35B-A3B-MLX-4bit",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local MLX)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "omlx",
      },
      "models": {
        "Qwen3.8-9B-heretic-uncensored-4bit-MTPLX": {
          "name": "Qwen3.8-9B-heretic-uncensored-4bit-MTPLX",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768,
          },
        },
        "Qwen3.8-27B-4bit": {
          "name": "Qwen3.8-27B-4bit",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768,
          },
        },
        "Ornith-1.5-35B-A3B-MLX-4bit": {
          "name": "Ornith-1.5-35B-A3B-MLX-4bit",
        },
      },
    },
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
    },
  },
  "plugin": ["opencode-export-html", "openslimedit@latest", "opencode-smartsnip@latest"],
}
