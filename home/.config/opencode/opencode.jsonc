{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local MLX)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "sk-omlx-1",
      },
      "models": {
        "Qwen3.5-9B-OptiQ-4bit": {
          "name": "Qwen3.5-9B-OptiQ-4bit",
        },
      },
    },
  },
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": true,
      "headers": {
        "X-Moz-1st-Party-Data-Opt-Out": "1",
      },
    },
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
    },
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
}
